<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/Login.css">
    <link rel="stylesheet" href="Logo_Wings.png">
</head>
<body>
    <div class="head-body">
    </div>
    <div class="login-box">
        <div class="title-login">
            <h1>Đăng nhập</h1>
        </div>
        
        @* Hiển thị thông báo lỗi *@
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }
        
        @* Hiển thị thông báo thành công từ đăng ký *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        
        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="text-box-login">
                <div class="name-login">
                    <span>Tên đăng nhập</span>
                    <input type="text" name="tenDangNhap" id="tenDangNhap" placeholder="Nhập tên đăng nhập" required>
                </div>
                <div class="password-login">
                    <span>Mật khẩu</span>
                    <input type="password" name="matKhau" id="matKhau" placeholder="Nhập mật khẩu" required>
                </div>
            </div>
            <button type="submit" class="button-login">
                <span>Đăng nhập</span>
            </button>
        </form>
        
        <div class="under-button">
            <span class="forgot-password">
                <a href="">Quên mật khẩu?</a>
            </span>
            <span class="register-account">
                <a href="/Home/Register">Đăng ký tài khoản</a>
            </span>
        </div>
    </div>
    <div class="tail-body">
    </div>
</body>
</html>