<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Bài Đăng Xe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/ManagePosts.css">
    <style>
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <div>
                    <h1><i class="bi bi-speedometer2 me-3"></i>Quản Lý Bài Đăng Xe</h1>
                    <p class="mb-0 mt-2">Quản lý toàn bộ tin đăng mua bán xe</p>
                </div>
                <button class="btn btn-add-new text-white" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
                    <i class="bi bi-plus-circle me-2"></i>Thêm Bài Đăng Mới
                </button>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="container-fluid px-4 py-4">
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="stats-card fade-in">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Tổng Bài Đăng</p>
                                <h3 class="mb-0 fw-bold" id="totalPosts">69,837</h3>
                            </div>
                            <div class="fs-1 text-primary">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.1s; border-left-color: var(--success-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Đang Hoạt Động</p>
                                <h3 class="mb-0 fw-bold text-success" id="activePosts">45,234</h3>
                            </div>
                            <div class="fs-1 text-success">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.2s; border-left-color: var(--warning-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Chờ Duyệt</p>
                                <h3 class="mb-0 fw-bold text-warning" id="pendingPosts">1,523</h3>
                            </div>
                            <div class="fs-1 text-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.3s; border-left-color: var(--danger-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Đã Ẩn</p>
                                <h3 class="mb-0 fw-bold text-danger" id="hiddenPosts">23,080</h3>
                            </div>
                            <div class="fs-1 text-danger">
                                <i class="bi bi-eye-slash"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="table-container">
            <div class="filter-section">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control search-box" id="searchInput" placeholder="🔍 Tìm kiếm theo tên xe, địa điểm...">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="categoryFilter">
                            <option value="">Tất cả danh mục</option>
                            <option value="oto">Ô tô</option>
                            <option value="xemay">Xe máy</option>
                            <option value="xedien">Xe điện</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">Tất cả trạng thái</option>
                            <option value="active">Đang hoạt động</option>
                            <option value="pending">Chờ duyệt</option>
                            <option value="hidden">Đã ẩn</option>
                            <option value="sold">Đã bán</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" onclick="applyFilters()">
                            <i class="bi bi-funnel me-2"></i>Lọc
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table custom-table">
                    <thead>
                        <tr>
                            <th width="5%">
                                <input type="checkbox" class="form-check-input" id="selectAll">
                            </th>
                            <th width="10%">Hình ảnh</th>
                            <th width="25%">Tiêu đề</th>
                            <th width="10%">Danh mục</th>
                            <th width="12%">Giá</th>
                            <th width="10%">Địa điểm</th>
                            <th width="8%">Trạng thái</th>
                            <th width="10%">Ngày đăng</th>
                            <th width="10%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="vehicleTableBody">
                        <!-- Data will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div class="text-muted">
                    Hiển thị <span id="showingCount">1-10</span> trong tổng số <span id="totalCount">69,837</span> bài đăng
                </div>
                <nav>
                    <ul class="pagination mb-0" id="pagination">
                        <!-- Pagination will be generated by JavaScript -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Add/Edit Vehicle Modal -->
    <div class="modal fade" id="addVehicleModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">
                        <i class="bi bi-plus-circle me-2"></i>Thêm Bài Đăng Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="vehicleForm">
                        <input type="hidden" id="vehicleId">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Tiêu đề bài đăng</label>
                                <input type="text" class="form-control" id="vehicleTitle" required placeholder="VD: Kia Carnival 2021 form 2022 bản 2.2D Signature">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Danh mục</label>
                                <select class="form-select" id="vehicleCategory" required>
                                    <option value="">Chọn danh mục</option>
                                    <option value="oto">Ô tô</option>
                                    <option value="xemay">Xe máy</option>
                                    <option value="xetai">Xe tải, xe ben</option>
                                    <option value="xedien">Xe điện</option>
                                    <option value="xedap">Xe đạp</option>
                                    <option value="phutung">Phụ tùng xe</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Giá (VNĐ)</label>
                                <input type="text" class="form-control" id="vehiclePrice" required placeholder="VD: 1.145.000.000">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Năm sản xuất</label>
                                <input type="number" class="form-control" id="vehicleYear" placeholder="2021">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Số km đã đi</label>
                                <input type="text" class="form-control" id="vehicleKm" placeholder="64000 km">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tình trạng</label>
                                <select class="form-select" id="vehicleCondition">
                                    <option value="new">Mới</option>
                                    <option value="used">Đã sử dụng</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Địa điểm</label>
                                <input type="text" class="form-control" id="vehicleLocation" required placeholder="VD: Thành Phố Thủ Đức">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Trạng thái</label>
                                <select class="form-select" id="vehicleStatus">
                                    <option value="pending">Chờ duyệt</option>
                                    <option value="active">Đang hoạt động</option>
                                    <option value="hidden">Đã ẩn</option>
                                    <option value="sold">Đã bán</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Hình ảnh</label>
                                <input type="file" class="form-control" id="vehicleImages" multiple accept="image/*">
                                <small class="text-muted">Có thể chọn nhiều hình ảnh</small>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Mô tả chi tiết</label>
                                <textarea class="form-control" id="vehicleDescription" rows="4" placeholder="Mô tả chi tiết về xe..."></textarea>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="saveVehicle()">
                        <i class="bi bi-save me-2"></i>Lưu Bài Đăng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ManagePosts.js">
    </script>
</body>
</html>