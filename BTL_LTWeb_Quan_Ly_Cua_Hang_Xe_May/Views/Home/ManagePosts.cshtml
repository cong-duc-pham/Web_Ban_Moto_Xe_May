@{
    ViewData["Title"] = "Quản lý bài đăng";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Bài Đăng Xe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/ManagePosts.css">
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <div>
                    <h1><i class="bi bi-speedometer2 me-3"></i>Quản Lý Bài Đăng Xe</h1>
                    <p class="mb-0 mt-2">Quản lý toàn bộ tin đăng mua bán xe</p>
                </div>
                <button class="btn btn-add-new text-white" onclick="showAddModal()">
                    <i class="bi bi-plus-circle me-2"></i>Thêm Bài Đăng Mới
                </button>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="container-fluid px-4 py-4">
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="stats-card fade-in">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Tổng Bài Đăng</p>
                                <h3 class="mb-0 fw-bold" id="totalPosts">69,837</h3>
                            </div>
                            <div class="fs-1 text-primary">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.1s; border-left-color: var(--success-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Đang Hoạt Động</p>
                                <h3 class="mb-0 fw-bold text-success" id="activePosts">45,234</h3>
                            </div>
                            <div class="fs-1 text-success">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.2s; border-left-color: var(--warning-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Chờ Duyệt</p>
                                <h3 class="mb-0 fw-bold text-warning" id="pendingPosts">1,523</h3>
                            </div>
                            <div class="fs-1 text-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card fade-in" style="animation-delay: 0.3s; border-left-color: var(--danger-color)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Đã Ẩn</p>
                                <h3 class="mb-0 fw-bold text-danger" id="hiddenPosts">23,080</h3>
                            </div>
                            <div class="fs-1 text-danger">
                                <i class="bi bi-eye-slash"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="table-container">
            <div class="filter-section">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control search-box" id="searchInput" placeholder="🔍 Tìm kiếm theo tên xe, địa điểm...">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="categoryFilter">
                            <option value="">Tất cả danh mục</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">Tất cả trạng thái</option>
                            <option value="active">Đang hoạt động</option>
                            <option value="pending">Chờ duyệt</option>
                            <option value="hidden">Đã ẩn</option>
                            <option value="sold">Đã bán</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" onclick="applyFilters()">
                            <i class="bi bi-funnel me-2"></i>Lọc
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table custom-table">
                    <thead>
                        <tr>
                            <th width="5%">
                                <input type="checkbox" class="form-check-input" id="selectAll">
                            </th>
                            <th width="10%">Hình ảnh</th>
                            <th width="25%">Tiêu đề</th>
                            <th width="10%">Danh mục</th>
                            <th width="12%">Giá</th>
                            <th width="10%">Địa điểm</th>
                            <th width="8%">Trạng thái</th>
                            <th width="10%">Ngày đăng</th>
                            <th width="10%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="vehicleTableBody">
                        <!-- Data populated by JS -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div class="text-muted">
                    Hiển thị <span id="showingCount">1-10</span> trong tổng số <span id="totalCount">69,837</span> bài đăng
                </div>
                <nav>
                    <ul class="pagination mb-0" id="pagination">
                        <!-- Pagination will be generated by JavaScript -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Add/Edit Vehicle Modal (form cấu trúc giống MotorbikeOnline - dùng cho Sửa và Thêm) -->
    <div class="modal fade" id="addVehicleModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Thêm Bài Đăng Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- NOTE: form id = vehicleForm (JS expects this). Fields use Vietnamese names/ids to match MotorbikeOnline; JS will map to English properties when sending. -->
                <div class="modal-body">
                    <form id="vehicleForm" novalidate>
                        <input type="hidden" id="vehicleId" name="VehicleId" value="0" />
                        <input type="hidden" id="xeID" name="ID" value="0" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label for="tenXe" class="form-label">Tên xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="tenXe" name="TenXe" required placeholder="Ví dụ: VinFast Klara S" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="cuaHang" class="form-label">Cửa hàng <span class="text-danger">*</span></label>
                                <select class="form-select" id="cuaHang" name="StoreId" required>
                                    <option value="">-- Chọn --</option>
                                    @{
                                        var stores = ViewBag.Stores as List<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.Store>;
                                        if (stores != null && stores.Count > 0)
                                        {
                                            foreach (var store in stores)
                                            {
                                                <option value="@store.StoreId">@store.StoreName</option>
                                            }
                                        }
                                        else
                                        {
                                            <option disabled>Không có dữ liệu</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="danhMuc" class="form-label">Danh mục <span class="text-danger">*</span></label>
                                <select class="form-select" id="danhMuc" name="CategoryId" required>
                                    <option value="">-- Chọn --</option>
                                    @{
                                        var categories = ViewBag.Categories as List<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.VehicleCategory>;
                                        if (categories != null && categories.Count > 0)
                                        {
                                            foreach (var cat in categories)
                                            {
                                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                                            }
                                        }
                                        else
                                        {
                                            <option disabled>Không có dữ liệu</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="thuongHieu" class="form-label">Thương hiệu <span class="text-danger">*</span></label>
                                <select class="form-select" id="thuongHieu" name="BrandId" required>
                                    <option value="">-- Chọn --</option>
                                    @{
                                        var brands = ViewBag.Brands as List<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.Brand>;
                                        if (brands != null && brands.Count > 0)
                                        {
                                            foreach (var brand in brands)
                                            {
                                                <option value="@brand.BrandId">@brand.BrandName</option>
                                            }
                                        }
                                        else
                                        {
                                            <option disabled>Không có dữ liệu</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="gia" class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="gia" name="Gia" required min="0" step="1000" placeholder="35000000" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="soLuong" class="form-label">Số lượng xe <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="soLuong" name="StockQuantity" required min="1" step="1" value="1" placeholder="Nhập số lượng xe trong kho" />
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> Số lượng xe hiện có trong kho
                                </small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="model" class="form-label">Model</label>
                                <input type="text" class="form-control" id="model" name="Model" placeholder="Ví dụ: Klara S 2024" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="namSX" class="form-label">Năm sản xuất</label>
                                <input type="number" class="form-control" id="namSX" name="ManufactureYear" min="2000" max="@(DateTime.Now.Year)" placeholder="2024" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="dungTich" class="form-label">Dung tích (cc)</label>
                                <input type="number" class="form-control" id="dungTich" name="EngineCapacity" min="0" placeholder="150" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="mauSac" class="form-label">Màu sắc</label>
                                <input type="text" class="form-control" id="mauSac" name="Color" placeholder="Đỏ, Đen, Xanh..." />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="hinhAnh" class="form-label">Hình ảnh xe</label>
                            <input type="file" class="form-control" id="hinhAnh" name="HinhAnh" accept="image/*" multiple />
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i> Có thể chọn nhiều hình ảnh. Hình đầu tiên sẽ là hình đại diện.
                            </small>
                            <div id="imagePreview" class="mt-2 d-flex flex-wrap gap-2"></div>
                        </div>

                        <div class="mb-3">
                            <label for="moTa" class="form-label">Mô tả</label>
                            <textarea class="form-control" id="moTa" name="MoTa" rows="3" placeholder="Nhập mô tả về xe máy..."></textarea>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Hủy
                    </button>
                    <!-- JS expects saveVehicleBtn (type=button so JS handles submit) -->
                    <button type="button" class="btn btn-primary" id="saveVehicleBtn">
                        <i class="bi bi-save me-2"></i>Lưu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/AdminLayout.js"></script>
    <script src="/js/ManagePosts.js"></script>
</body>
</html>