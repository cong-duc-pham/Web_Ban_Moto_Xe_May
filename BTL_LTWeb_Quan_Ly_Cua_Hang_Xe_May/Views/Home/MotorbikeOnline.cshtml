@using BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities;

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="VinFast Official Store - Mua xe điện chính hãng trên Chợ Tốt Xe">
    <title>VinFast Official Store - Chợ Tốt Xe</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700;900&display=swap"
          rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css//MotorbikeOnline.css">
</head>

<body>
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container">
            <div class="d-flex justify-content-between">
                <div class="d-flex align-items-center">
                    <a href="#">Chợ Tốt</a>
                    <span>|</span>
                    <a href="#">Nhà Tốt</a>
                    <span>|</span>
                    <a href="#">Chợ Tốt Xe</a>
                    <span>|</span>
                    <a href="#">Việc Làm Tốt</a>
                </div>
                <div class="d-flex align-items-center">
                    <a href="#">Đóng góp ý kiến</a>
                    <a href="#">Tải ứng dụng</a>
                    <a href="#">Trợ giúp</a>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fas fa-tag me-1"></i> Dành cho người mua
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Hướng dẫn mua hàng</a></li>
                            <li><a class="dropdown-item" href="#">Phương thức thanh toán</a></li>
                            <li><a class="dropdown-item" href="#">Chính sách đổi trả</a></li>
                        </ul>
                    </div>
                    <button class="btn btn-sm btn-light ms-2">
                        <i class="fas fa-briefcase me-1"></i> Dành cho người bán
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <a href="#" class="logo d-flex align-items-center gap-0 ">
                        <img src="/images/logo.png" alt="" class="logo-icon">
                        <img src="/images/logo_word.png" alt="" class="logo-text">
                    </a>
                </div>
                <div class="col-md-6">
                    <div class="search-bar">
                        <input type="text" class="search-input" placeholder="Tìm kiếm xe trên Chợ Tốt Xe">
                        <button class="search-btn me-n2">
                            <i class="fas fa-search"></i>
                        </button>

                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center justify-content-end">
                        <i class="fas fa-bell header-icon"></i>
                        <i class="fas fa-comment-dots header-icon"></i>
                        <div class="user-info ms-2">
                           
                            @* <span class="d-none d-md-inline">Quản lý tin</span> *@
                        </div>
                        <div class="dropdown ms-2">
                            <a href="#" class="d-flex align-items-center dropdown-toggle" data-bs-toggle="dropdown">
                                <img src="https://i.pravatar.cc/32" alt="User" class="user-avatar">
                                <span class="d-none d-md-inline ms-1">Hoàng Thanh Dat</span>
                                <i class="fas fa-chevron-down ms-1"></i>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Tài khoản của tôi</a></li>
                                <li><a class="dropdown-item" href="#">Tin đã đăng</a></li>
                                <li><a class="dropdown-item" href="#">Tin đã lưu</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#">Đăng xuất</a></li>
                            </ul>
                        </div>
                        <a asp-controller="Home" asp-action="LiquidationCar" class="btn btn-info">
                            BÁN XE
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb -->
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Chợ Tốt Xe</a></li>
                <li class="breadcrumb-item"><a href="#">Cửa Hàng Chính Hãng</a></li>
                <li class="breadcrumb-item active" aria-current="page">VinFast Official Store</li>
            </ol>
        </nav>
    </div>

    <!-- Store Header -->
    <section class="store-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <img src="https://i.imgur.com/6pK8Q9F.png" alt="VinFast" class="store-logo">
                        <div>
                            <h1 class="store-name">VinFast Official Store</h1>
                            <div class="official-badge">
                                <i class="fas fa-check-circle"></i> CHÍNH HÃNG
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="store-stats">
                        <div class="mb-2">Sản phẩm: 13</div>
                        <a href="#" class="store-locations">
                            <i class="fas fa-map-marker-alt"></i> Xem 132 chi nhánh cửa hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hero Banner -->
    <section class="hero-banner">
        <img src="https://images.unsplash.com/photo-1617654112368-307921291f42?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1170&q=80"
             alt="VinFast Showroom">
    </section>

    <!-- Store Info Section -->
    <section class="store-info-section">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="info-card">
                        <h3>Giới thiệu</h3>
                        <p>Cửa hàng Chính hãng của VinFast</p>
                        <div class="phone-number">
                            <i class="fas fa-phone"></i>
                            <span id="phoneNumber">07678****</span>
                            <button class="btn-reveal" id="revealPhoneBtn">Hiện số</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-card">
                        <h3>Chính sách cửa hàng</h3>
                        <div class="policy-item">
                            <i class="fas fa-car"></i>
                            <div>Thu mua xe cũ</div>
                        </div>
                        <div class="policy-item">
                            <i class="fas fa-gift"></i>
                            <div>Quà tặng hấp dẫn khi mua trên Chợ Tốt</div>
                        </div>
                        <div class="policy-item">
                            <i class="fas fa-credit-card"></i>
                            <div>Hỗ trợ trả góp từ 3 đến 12 tháng</div>
                        </div>
                        <div class="policy-item">
                            <i class="fas fa-cogs"></i>
                            <div>Cung cấp phụ tùng, phụ kiện chính hãng</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Listing -->
    <section class="products-section">
        <div class="container">
            <h2 class="section-title">Sản phẩm đang bán</h2>
            <div class="row g-3" id="productGrid">
                <!-- Products will be inserted by JavaScript -->
                @{
                    if (ViewData["lstXeMay"] != null)
                        foreach (XeMay xe in ViewBag.lstXeMay)
                        {
                            <div class="product-item">
                                <span class="badge badge-official">CHÍNH HÃNG</span>
                                <img src="~/images/@xe.HinhAnh" alt="@xe.TenXe" class="product-image" />
                                <h3 class="product-name">@xe.TenXe</h3>
                                <p class="product-price">@string.Format("{0:N0} đ", xe.Gia)</p>

                                @if (!string.IsNullOrEmpty(xe.MoTa))
                                {
                                    <p class="product-desc">@xe.MoTa</p>
                                }
                            </div>
                        }
                    }
                
              
            </div>
            <div class="text-center">
                <button class="btn btn-load-more" id="loadMoreBtn">Xem thêm tin đăng</button>
            </div>
        </div>
    </section>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <link rel="stylesheet" href="/js/MotorbikeOnline.js">
</body>

</html>