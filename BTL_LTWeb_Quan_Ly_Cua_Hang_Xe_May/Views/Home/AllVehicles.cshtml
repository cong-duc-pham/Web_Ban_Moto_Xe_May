<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bản tin mua bán xe giá rẻ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/AllVehicles.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/nouislider@15.7.0/dist/nouislider.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/nouislider@15.7.0/dist/nouislider.min.js"></script>
</head>
<body>
    <!-- Header -->
    <header class="sticky-header">
        <div class="header-container">
            <div class="header-left">
                <button class="header-icon-btn hamburger-menu" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <a href="#" class="header-logo">
                    Auto<span class="logo-xe">Wings</span>
                </a>
                <button class="location-selector">
                    <span>Toàn quốc</span>
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>

            <div class="header-center">
                <form class="search-form" action="/search">
                    <div class="search-bar">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text"
                               placeholder="Tìm xe cộ..."
                               name="query"
                               class="search-input" />
                    </div>
                    <button type="submit" class="search-submit-btn" aria-label="Tìm kiếm">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
            </div>

            <div class="header-right">
                <button class="header-icon-btn" aria-label="Tin đã lưu">
                    <i class="far fa-heart"></i>
                </button>
                <button class="header-icon-btn" aria-label="Thông báo">
                    <i class="far fa-bell"></i>
                </button>
                <a href="#" class="manage-link">Quản lý tin</a>
                <a href="#" class="post-ad-btn">Đăng xe</a>
                <button class="user-profile-btn" aria-label="Tài khoản">
                    <span class="avatar-initial">B</span>
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        </div>
    </header>
    <div class="container bg-white mt-lg-4 rounded-5">
        <!-- Top Bar -->
        <div class="top-bar rounded-5">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">Chợ Tốt Xe</a></li>
                        <li class="breadcrumb-item active">Xe cộ</li>
                    </ol>
                </nav>
                <h1 class="page-title">Mua bán xe giá rẻ cập nhật tháng 11/2025</h1>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="container">
                <div class="filter-controls">
                    <button class="filter-btn" onclick="openPopup('popup-filter')">
                        Lọc
                    </button>
                    <button class="filter-btn" onclick="openPopup('popup-price')">
                        Giá
                    </button>
                    <button class="filter-btn" onclick="openPopup('popup-status')">
                        Tình trạng
                    </button>
                    <a href="#" id="clear-all-filters-link" class="clear-filter-link d-none d-md-inline">Xoá lọc</a>
                </div>
            </div>
        </div>

        <!-- pop up lọc-->
        <div id="popup-filter" class="popup-modal" style="display: none">
            <div class="popup-content">
                <div class="popup-header">
                    <span>Lọc Nâng Cao</span>
                    <button class="close-popup" onclick="closePopup('popup-filter')">
                        &times;
                    </button>
                </div>
                <div class="popup-body">
                    <div class="filter-section">
                        <div class="filter-title">Tình trạng</div>
                        <label>
                            <input type="checkbox"
                                   class="flt"
                                   value="used"
                                   onchange="updateSelectedFilters()" />
                            Đã sử dụng
                        </label>
                        <label>
                            <input type="checkbox"
                                   class="flt"
                                   value="new"
                                   onchange="updateSelectedFilters()" />
                            Mới
                        </label>
                    </div>
                    <div class="filter-section">
                        <div class="filter-title">Tin có video</div>
                        <label class="switch">
                            <!-- Mới thêm -->
                            <input type="checkbox"
                                   class="flt"
                                   value="video"
                                   onchange="updateSelectedFilters()" /><span class="slider"></span>
                        </label>
                    </div>
                    <div class="filter-section">
                        <div class="filter-title">Đăng bởi</div>
                        <label>
                            <input type="checkbox"
                                   class="flt"
                                   value="person"
                                   onchange="updateSelectedFilters()" />
                            Cá nhân
                        </label>
                        <label>
                            <input type="checkbox"
                                   class="flt"
                                   value="professional"
                                   onchange="updateSelectedFilters()" />
                            Bán chuyên
                        </label>
                        <label>
                            <input type="checkbox"
                                   class="flt"
                                   value="partner"
                                   onchange="updateSelectedFilters()" />
                            Đối Tác Chợ Tốt
                        </label>
                    </div>
                    <!-- Chip filter đã tick, sẽ hiện ra dưới -->
                    <div id="selected-filters" class="selected-filters">
                        Lọc theo:
                        <!-- mục đã chọn sẽ xuất hiện tại đây -->
                    </div>
                    <div class="popup-actions">
                        <button onclick="clearFilters()">Xóa lọc</button>
                        <button class="btn-primary" onclick="applyFilters()">
                            Áp dụng
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Popup Giá -->
        <div id="popup-price" class="popup-modal" style="display: none">
            <div class="popup-content">
                <div class="popup-header">
                    <span>Chọn khoảng giá</span>
                    <button class="close-popup" onclick="closePopup('popup-price')">
                        &times;
                    </button>
                </div>
                <div class="popup-body">
                    <div class="price-slider-section">
                        <div id="price-slider"></div>
                        <div class="slider-labels">
                            <span>0</span>
                            <span>1.5 tỷ</span>
                        </div>
                        <div class="price-num-wrap">
                            <div class="price-field">
                                <label>Giá tối thiểu</label>
                                <input type="number"
                                       id="minPriceInput"
                                       min="0"
                                       max="1500000000"
                                       value="0"
                                       onchange="updateSliderFromInput()" />
                                <span class="currency">đ</span>
                            </div>
                            <span style="font-size: 22px; color: #888; margin: 0 9px">-</span>
                            <div class="price-field">
                                <label>Giá tối đa</label>
                                <input type="number"
                                       id="maxPriceInput"
                                       min="0"
                                       max="1500000000"
                                       value="1500000000"
                                       onchange="updateSliderFromInput()" />
                                <span class="currency">đ</span>
                            </div>
                        </div>
                    </div>
                    <div class="popup-actions">
                        <button onclick="clearPrice()">Xóa lọc</button>
                        <button class="btn-primary" onclick="applyPrice()">Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- pop up tình trạng -->
        <div id="popup-status" class="popup-modal" style="display: none">
            <div class="popup-content">
                <div class="popup-header">
                    <span>Tình trạng</span>
                    <button class="close-popup" onclick="closePopup('popup-status')">
                        &times;
                    </button>
                </div>
                <div class="popup-body">
                    <label>
                        <input type="radio"
                               name="status"
                               value="used"
                               onchange="selectStatus()" />
                        Đã sử dụng
                    </label>
                    <label>
                        <input type="radio"
                               name="status"
                               value="new"
                               onchange="selectStatus()" />
                        Mới
                    </label>
                    <div class="popup-actions">
                        <button onclick="clearStatus()">Xóa lọc</button>
                    </div>
                </div>
            </div>
        </div>

