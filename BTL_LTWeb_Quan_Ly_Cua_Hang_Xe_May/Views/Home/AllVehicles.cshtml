@{
    Layout = "_Layout";
    ViewData["Title"] = "Mua bán xe - All Vehicles";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bản tin mua bán xe giá rẻ</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="/css/AllVehicles.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.7.0/dist/nouislider.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/nouislider@15.7.0/dist/nouislider.min.js"></script>

    <!-- ✅ THÊM Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

    <!-- ✅ SweetAlert2 (CHỈ 1 LẦN) -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>
<body>
    @await Html.PartialAsync("_Header")

    <div class="container bg-white mt-lg-4 rounded-5">
        <!-- Top Bar -->
        <div class="top-bar rounded-5">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">Chợ Tốt Xe</a></li>
                        <li class="breadcrumb-item active">Xe cộ</li>
                    </ol>
                </nav>
                <h1 class="page-title">Mua bán xe giá rẻ cập nhật tháng 11/2025</h1>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="container">
                <div class="filter-controls">
                    <button class="filter-btn" onclick="openPopup('popup-filter')">Lọc</button>
                    <button class="filter-btn" onclick="openPopup('popup-price')">Giá</button>
                    <button class="filter-btn" onclick="openPopup('popup-status')">Tình trạng</button>
                    <a href="#" id="clear-all-filters-link" class="clear-filter-link d-none d-md-inline">Xoá lọc</a>
                </div>
            </div>
        </div>

        <!-- Popup Lọc (dynamic) -->
        <div id="popup-filter" class="popup-modal" style="display:none">
            <div class="popup-content d-flex flex-column flex-lg-row gap-3" style="max-width:980px; width:100%;">
                <div class="popup-main flex-fill">
                    <div class="popup-header d-flex justify-content-between align-items-center">
                        <span>Lọc Nâng Cao</span>
                        <button class="close-popup" onclick="closePopup('popup-filter')">&times;</button>
                    </div>
                    <div class="popup-body">
                        <div class="filter-section">
                            <div class="filter-title">Hãng xe</div>
                            <div id="brand-list-short" class="d-flex flex-wrap gap-2"></div>
                            <button type="button" class="btn btn-link p-0" onclick="openPopup('popup-brand')">Xem thêm</button>
                        </div>

                        <div class="filter-section">
                            <div class="filter-title">Màu sắc</div>
                            <div id="popup-colors" class="d-flex flex-wrap gap-2"></div>
                        </div>

                        <div class="filter-section">
                            <div class="filter-title">Loại xe</div>
                            <div id="popup-types" class="d-flex flex-wrap gap-2"></div>
                        </div>

                        <div class="filter-section">
                            <div class="filter-title">Tình trạng</div>
                            <div id="popup-condition" class="d-flex flex-wrap gap-2"></div>
                        </div>

                        <div class="popup-actions d-flex justify-content-between mt-3">
                            <button class="btn btn-sm btn-outline-secondary" onclick="clearPopupFilters()">Xóa lọc</button>
                            <button class="btn btn-primary btn-sm" onclick="applyPopupFilters()">Áp dụng</button>
                        </div>
                    </div>
                </div>

                <aside class="popup-right" style="width:280px;">
                    <div class="popup-header"><strong>Đã chọn</strong></div>
                    <div id="selected-filters-container" class="p-2">
                        <div id="selected-filters">Lọc theo:</div>
                    </div>
                    <div class="p-2">
                        <button class="btn btn-sm btn-outline-danger w-100" onclick="clearAllAndApply()">Xóa tất cả và áp dụng</button>
                    </div>
                </aside>
            </div>
        </div>

        <!-- Popup xem thêm hãng (dynamic) -->
        <div id="popup-brand" class="popup-modal" style="display:none">
            <div class="popup-content" style="max-width:700px; width:100%;">
                <div class="popup-header d-flex justify-content-between align-items-center">
                    <span>Chọn hãng xe</span>
                    <button class="close-popup" onclick="closePopup('popup-brand')">&times;</button>
                </div>
                <div class="popup-body">
                    <input id="brand-search" class="form-control mb-2" placeholder="Tìm hãng xe..." oninput="filterBrandList()" />
                    <div id="brand-list-full" class="d-flex flex-wrap gap-2"></div>
                    <div class="popup-actions mt-2 d-flex justify-content-end">
                        <button class="btn btn-sm btn-secondary" onclick="closePopup('popup-brand')">Đóng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Popup Giá -->
        <div id="popup-price" class="popup-modal" style="display:none">
            <div class="popup-content">
                <div class="popup-header">
                    <span>Chọn khoảng giá</span>
                    <button class="close-popup" onclick="closePopup('popup-price')">&times;</button>
                </div>
                <div class="popup-body">
                    <div class="price-slider-section">
                        <div id="price-slider"></div>
                        <div class="slider-labels"><span>0</span><span>100 triệu</span></div>
                        <div class="price-num-wrap">
                            <div class="price-field">
                                <label>Giá tối thiểu</label>
                                <input type="number" id="minPriceInput" min="0" max="100000000" value="0" onchange="updateSliderFromInput()" />
                                <span class="currency">đ</span>
                            </div>
                            <span style="font-size:22px; color:#888; margin:0 9px">-</span>
                            <div class="price-field">
                                <label>Giá tối đa</label>
                                <input type="number" id="maxPriceInput" min="0" max="100000000" value="100000000" onchange="updateSliderFromInput()" />
                                <span class="currency">đ</span>
                            </div>
                        </div>
                    </div>
                    <div class="popup-actions">
                        <button onclick="clearPrice()">Xóa lọc</button>
                        <button class="btn-primary" onclick="applyPrice()">Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Popup Tình trạng -->
        <div id="popup-status" class="popup-modal" style="display:none">
            <div class="popup-content">
                <div class="popup-header">
                    <span>Tình trạng</span>
                    <button class="close-popup" onclick="closePopup('popup-status')">&times;</button>
                </div>
                <div class="popup-body">
                    <label><input type="radio" name="status" value="used" onchange="selectStatus()" /> Đã sử dụng</label>
                    <label><input type="radio" name="status" value="new" onchange="selectStatus()" /> Mới</label>
                    <div class="popup-actions">
                        <button onclick="clearStatus()">Xóa lọc</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khu vực (dynamic) -->
        <div class="container">
            <div class="location-section">
                <div class="location-pills">
                    <span class="location-label">Khu vực:</span>
                    <!-- JS sẽ bơm các .location-pill ở đây -->
                </div>
            </div>

            <!-- Category Icons -->
            <div class="category-section">
                <div class="category-icons" id="category-icons">
                    <a asp-controller="Home" asp-action="Motorbikes" class="category-item" data-category="Xe máy">
                        <img src="/images/2020.svg" class="category-icon" alt="Xe máy">
                        <div class="category-name">Xe máy</div>
                    </a>
                    <a asp-controller="Home" asp-action="Electric" class="category-item" data-category="Xe điện">
                        <img src="/images/2020.svg" class="category-icon" alt="Xe điện">
                        <div class="category-name">Xe điện</div>
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="row">
                <!-- Listings -->
                <div class="col-lg-9">
                    <div class="tabs-section d-flex justify-content-between">
                        <ul class="nav nav-tabs">
                            <li class="nav-item"><a class="nav-link active" href="#">Tất cả</a></li>
                        </ul>
                        <div class="sort-bar">
                            <button class="sort-btn me-lg-3">
                                Tin mới nhất <i class="fas fa-chevron-down" style="font-size:10px"></i>
                            </button>
                            <div class="view-toggle d-none d-md-flex">
                                <button class="view-btn active" id="list-view-btn"><i class="fas fa-list"></i></button>
                                <button class="view-btn" id="grid-view-btn"><i class="fas fa-th"></i></button>
                            </div>
                        </div>
                    </div>

                    <div id="listings-container" class="list-view"></div>
                </div>

                <!-- Sidebar bộ lọc động (KHÔNG lồng col vào col) -->
                <div class="col-lg-3 mt-lg-5">
                    <div class="sidebar-section" id="active-filters-container" style="display:none;">
                        <div class="sidebar-title">Đang lọc theo</div>
                        <div class="sidebar-option" id="active-filters-display"></div>
                    </div>

                    <div class="sidebar-section" id="sb-brands">
                        <div class="sidebar-title">Hãng xe</div>
                    </div>

                    <div class="sidebar-section" id="sb-colors">
                        <div class="sidebar-title">Màu sắc</div>
                    </div>

                    <div class="sidebar-section" id="sb-types">
                        <div class="sidebar-title">Loại</div>
                    </div>

                    <div class="sidebar-section" id="sb-condition">
                        <div class="sidebar-title">Tình trạng</div>
                        <!-- JS sẽ inject radio nếu có -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <nav class="pagination-container" aria-label="Page navigation"></nav>
    </div>

    @await Html.PartialAsync("_Footer")
    <script src="~/js/main.js"></script>
    <script src="/js/AllVehicles.js"></script>
</body>
</html>