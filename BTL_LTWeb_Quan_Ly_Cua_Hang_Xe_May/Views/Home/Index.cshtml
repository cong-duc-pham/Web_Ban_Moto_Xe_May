    <!-- Store Activities -->
    <section class="py-5 bg-white">
        <div class="container">
            <h2 class="section-title">Hoạt động nổi bật của cửa hàng</h2>
            <div class="position-relative">
                <button class="carousel-nav carousel-nav-prev d-none d-lg-flex" data-carousel="activities">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="carousel-wrapper" id="activitiesCarousel">
                    <!-- Activity 1 -->
                    <div class="activity-card" data-activity-id="1" role="button" tabindex="0">
                        <div class="activity-header">
                            <img src="https://ui-avatars.com/api/?name=CD&background=random&size=48"
                                 alt="Cầm Q8 - Thanh Lý Trao Đổi Xe Máy Cũ" class="activity-avatar">
                            <div class="activity-info">
                                <div class="activity-store-name">
                                    Cầm Q8 - Thanh Lý Trao Đổi Xe Máy Cũ
                                    <i class="fas fa-check-circle verified-badge"></i>
                                </div>
                                <div class="activity-meta">9 giờ trước • Quận 8, Tp HCM</div>
                            </div>
                        </div>
                        <div class="activity-content">
                            <div class="activity-text">1 nhất 📌 cho e zai nhanh lẹ</div>
                            <div class="activity-images">
                                <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=600&h=600&fit=crop"
                                     alt="Activity" class="activity-image" loading="lazy">
                                <img src="https://images.unsplash.com/photo-1568772684723-dc07fcb3e9c0?w=600&h=600&fit=crop"
                                     alt="Activity" class="activity-image" loading="lazy">
                            </div>
                            <div class="activity-actions">
                                <div class="activity-action">
                                    <i class="far fa-thumbs-up"></i>
                                    <span>0</span>
                                </div>
                                <div class="activity-action">
                                    <i class="far fa-comment"></i>
                                    <span>0</span>
                                </div>
                            </div>
