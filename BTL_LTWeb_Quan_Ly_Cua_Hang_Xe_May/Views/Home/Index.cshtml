                                <div class="store-product-price">15.664.000 đ</div>
                            </div>
                        </div>
                    </div>
                    <!-- Store 2 -->
                    <div class="official-store-card">
                        <div class="store-header">
                            <img src="https://ui-avatars.com/api/?name=HP&background=e74c3c&color=fff&size=48"
                                 alt="Head Phát Tiến" class="store-logo">
                            <div class="store-name">
                                Head Phát Tiến
                                <i class="fas fa-check-circle verified-badge"></i>
                            </div>
                        </div>
                        <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=600&h=200&fit=crop"
                             alt="Head Phát Tiến banner" class="store-banner" loading="lazy">
                        <div class="store-products">
                            <div class="store-product-item">
