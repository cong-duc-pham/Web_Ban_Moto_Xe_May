@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Chợ Tốt X  © 2025  - Mua bán xe ô tô, xe máy, xe điện uy tín hàng đầu Việt Nam">
    <title>Chợ Tốt Xe - Mua Bán Xe Uy Tín Hàng Đầu Việt Nam</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700;900&display=swap"
          rel="stylesheet">

    <!-- Custom CSS (Minimal) -->
    <link rel="stylesheet" href="../css/style.css">
</head>

<body class="bg-light overflow-x-hidden">
    <!-- Header -->
    <!-- Header -->
    <header class="sticky-top bg-white shadow-sm">


        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-content">
                <button class="btn-close-menu" id="closeMobileMenu">
                    <i class="fas fa-times"></i>
                </button>

            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section position-relative overflow-hidden">
        <!-- Header Top moved here -->
        <div class="container">
            <div class="d-flex align-items-center justify-content-between py-2">
                <!-- Logo -->
                <a href="#" class="logo d-flex align-items-center gap-0 ">
                    <img src="/images/logo.png" alt="" class="logo-icon">
                    <img src="/images/logo_word.png" alt="" class="logo-text">
                </a>
                <div class="container-fluid">
                    <!-- Secondary Navigation -->
                    <div class=" d-none d-lg-block">
                        <div class="container">
                            <div class="py-2">
                                <a href="#" class="text-decoration-none text-dark">
                                    Dành cho người bán <i class="fas fa-chevron-down ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Yêu thích">
                        <i class="far fa-heart"></i>
                    </button>
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Tin nhắn">
                        <i class="far fa-comment-dots"></i>
                    </button>
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Thông báo">
                        <i class="far fa-bell"></i>
                    </button>
                    <a href="/Home/Login">
                       <button class="btn btn-outline-primary d-none d-md-inline-flex"> Đăng nhập</button></a>
                    <button class="btn btn-primary">Bán xe</button>
                    <button class="btn-icon d-none d-md-inline-flex">
                        <i class="fas fa-user-circle"></i>
                        <i class="fas fa-chevron-down ms-1 fs-6"></i>
                    </button>
                    <button class="btn-icon d-lg-none" id="mobileMenuToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="text-center">
                <h1 class="hero-title mb-0">&#34;Xe&#34; mới toanh. Khám phá nhanh!</h1>
            </div>
        </div>
        <div class="hero-illustration-left">🚗🌳</div>
        <div class="hero-illustration-right">🚚🚐</div>
    </section>

    <!-- Search Bar Section -->
    <section class="search-section">
        <div class="container">
            <div class="search-bar-container">
                <div class="search-bar">
                    <div class="search-input-group">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" class="search-input" id="searchInput" placeholder="Tìm xe cộ...">
                    </div>
                    <div class="search-divider d-none d-md-block"></div>
                    <div class="search-select-group">
                        <i class="fas fa-map-marker-alt select-icon"></i>
                        <select class="search-select" id="locationSelect">
                            <option selected>Chọn khu vực</option>
                            <option value="hn">Hà Nội</option>
                            <option value="hcm">Hồ Chí Minh</option>
                            <option value="dn">Đà Nẵng</option>
                            <option value="hp">Hải Phòng</option>
                            <option value="ct">Cần Thơ</option>
                        </select>
                    </div>
                    <div class="search-divider d-none d-md-block"></div>
                    <div class="search-select-group">
                        <i class="fas fa-car select-icon"></i>
                        <select class="search-select" id="vehicleTypeSelect">
                            <option selected>Tất cả Xe cộ</option>
                            <option value="car">Ô tô</option>
                            <option value="motorbike">Xe máy</option>
                            <option value="truck">Xe tải, xe ben</option>
                            <option value="electric">Xe điện</option>
                            <option value="bicycle">Xe đạp</option>
                            <option value="parts">Phụ tùng xe</option>
                        </select>
                    </div>
                    <button class="btn btn-search" id="searchBtn">Tìm xe</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Strip -->
    <section class="py-0">
        <div class="container">
            <div class="category-strip">
                <div class="category-item text-center">
                    <div class="category-icon">🚗</div>
                    <div class="category-label">Ô tô</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">🏍️</div>
                    <div class="category-label">Xe máy</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">🚚</div>
                    <div class="category-label">Xe tải, xe ben</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">🛵</div>
                    <div class="category-label">Xe điện</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">🚲</div>
                    <div class="category-label">Xe đạp</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">🚜</div>
                    <div class="category-label">Phương tiện khác</div>
                </div>
                <div class="category-item text-center">
                    <div class="category-icon">⚙️</div>
                    <div class="category-label">Phụ tùng xe</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Latest Listings -->
    <section class="py-5">
        <div class="container">
            <h2 class="section-title">Tin đăng mới nhất</h2>
            <div class="position-relative">
                <button class="carousel-nav carousel-nav-prev d-none d-lg-flex" data-carousel="latestListings">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="carousel-wrapper" id="latestListingsCarousel">
                    <!-- Xe 1 -->
                    <div class="product-card" data-id="1">
                        <div class="product-image-container">
                            <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=400&h=300&fit=crop"
                                 alt="WAVE 2013, Nguyên Zin, Bán Rẻ Bảo" class="product-image" loading="lazy">
                            <div class="product-badge">29 giây trước</div>
                            <button class="product-favorite" data-id="1" aria-label="Yêu thích">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                        <div class="product-content">
                            <h3 class="product-title">WAVE 2013, Nguyên Zin, Bán Rẻ Bảo</h3>
                            <div class="product-meta">2013 • Xe số • Đã dùng</div>
                            <div class="product-price">9.800.000</div>
                            <div class="product-location">
                                <i class="fas fa-map-marker-alt"></i> Quận 12
                            </div>
                        </div>
                    </div>
                    <!-- Xe 2 -->
                    <div class="product-card" data-id="2">
                        <div class="product-image-container">
                            <img src="https://images.unsplash.com/photo-1593941707882-a5bba14938c7?w=400&h=300&fit=crop"
                                 alt="VF8 PLUS HỖ TRỢ VAY LÊN ĐẾN 90%" class="product-image" loading="lazy">
                            <div class="product-badge">Tin tiêu biểu</div>
                            <button class="product-favorite" data-id="2" aria-label="Yêu thích">
                                <i class="far fa-heart"></i>
                            </button>
                            <div class="product-badge" style="right:12px; left: auto; background: #FF3B3B;">
                                Tin tiêu
                                biểu
                            </div>
                        </div>
                        <div class="product-content">
                            <h3 class="product-title">VF8 PLUS HỖ TRỢ VAY LÊN ĐẾN 90% NHẬN XE</h3>
                            <div class="product-meta">2025 • Ô tô • Tự động</div>
                            <div class="product-price">978.000.000</div>
                            <div class="product-location">
                                <i class="fas fa-map-marker-alt"></i> Quận 5
                            </div>
                        </div>
                    </div>
                    <!-- Xe 3 -->
                    <div class="product-card" data-id="3">
                        <div class="product-image-container">
                            <img src="https://images.unsplash.com/photo-1568772684723-dc07fcb3e9c0?w=400&h=300&fit=crop"
                                 alt="SH MODE BẢN CAO CẤP ABS - THU CŨ ĐỔI MỚI" class="product-image" loading="lazy">
                            <div class="product-badge">39 giây trước</div>
                            <button class="product-favorite" data-id="3" aria-label="Yêu thích">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                        <div class="product-content">
                            <h3 class="product-title">SH MODE BẢN CAO CẤP ABS - THU CŨ ĐỔI MỚI</h3>
                            <div class="product-meta">2025 • Tay ga • Mới</div>
                            <div class="product-price">61.720.000</div>
                            <div class="product-location">
                                <i class="fas fa-map-marker-alt"></i> Quận 7
                            </div>
                        </div>
                    </div>
                    <!-- ... Thêm các xe khác tương tự ... -->
                </div>
                <button class="carousel-nav carousel-nav-next d-none d-lg-flex" data-carousel="latestListings">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            <div class="text-center mt-4">
                <button class="btn btn-outline-secondary">Xem thêm 72.016 tin đăng</button>
            </div>
        </div>
    </section>

    <!-- Official Stores -->
    <section class="py-5 bg-white">
        <div class="container">
            <h2 class="section-title">Đặt Xe Online <span class="text-danger fw-black">CHÍNH HÃNG</span></h2>
