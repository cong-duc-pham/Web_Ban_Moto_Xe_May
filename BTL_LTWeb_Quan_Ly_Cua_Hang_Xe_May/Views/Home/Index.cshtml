                        </div>
                        <div class="store-info">
                            <div class="store-title">
                                TONG MOTOR
                                <i class="fas fa-check-circle verified-badge"></i>
                            </div>
                            <div class="store-rating">
                                <span class="stars">★★★☆☆</span>
