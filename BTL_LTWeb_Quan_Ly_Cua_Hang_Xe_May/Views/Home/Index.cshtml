                                <div class="store-product-name">Xe máy Honda ...</div>
                                <div class="store-product-price">19.730.000 đ</div>
                            </div>
                            <div class="store-product-item">
                                <img src="https://images.unsplash.com/photo-1609630875171-b1321377ee65?w=150&h=150&fit=crop"
                                     alt="Xe máy Honda ..." class="store-product-image" loading="lazy">
                                <div class="store-product-name">Xe máy Honda ...</div>
                                <div class="store-product-price">19.350.000 đ</div>
                            </div>
                        </div>
                    </div>
                    <!-- ... lặp tiếp các store ... -->
                </div>

                <button class="carousel-nav carousel-nav-next d-none d-lg-flex" data-carousel="officialStores">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="MotorbikeOnline" class="btn btn-info">
                    Xem thêm cửa hàng
                </a>
            </div>
        </div>
    </section>

    <!-- Featured Stores -->
    <section class="py-5">
        <div class="container">
            <h2 class="section-title">Cửa hàng xe nổi bật</h2>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <button class="tab-chip active" data-tab="all">Tất cả</button>
                <button class="tab-chip" data-tab="car">Ô tô</button>
                <button class="tab-chip" data-tab="motorbike">Xe máy</button>
                <button class="tab-chip" data-tab="truck">Xe tải, xe ben</button>
                <button class="tab-chip" data-tab="electric">Xe điện</button>
                <button class="tab-chip" data-tab="bicycle">Xe đạp</button>
                <button class="tab-chip" data-tab="parts">Phụ tùng</button>
            </div>
            <div class="position-relative">
                <button class="carousel-nav carousel-nav-prev d-none d-lg-flex" data-carousel="featuredStores">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="carousel-wrapper" id="featuredStoresCarousel">
                    <!-- Store 1 -->
                    <div class="featured-store-card">
