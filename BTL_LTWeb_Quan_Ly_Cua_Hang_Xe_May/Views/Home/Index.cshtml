                             alt="VinFast Official Store banner" class="store-banner" loading="lazy">
                        <div class="store-products">
                            <div class="store-product-item">
                                <img src="https://images.unsplash.com/photo-1568772684723-dc07fcb3e9c0?w=150&h=150&fit=crop"
                                     alt="VinFast Motio" class="store-product-image" loading="lazy">
