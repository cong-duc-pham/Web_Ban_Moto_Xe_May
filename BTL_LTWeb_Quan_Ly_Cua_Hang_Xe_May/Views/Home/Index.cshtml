@model BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Controllers.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
}
@* DEBUG: Hiển thị thông tin Session
@if (!string.IsNullOrEmpty(Context.Session.GetString("TenDangNhap")))
{
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var hoVaTen = Context.Session.GetString("HoVaTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var userId = Context.Session.GetInt32("UserID");
    
    <div class="alert alert-info" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 9999; max-width: 350px;">
        <h5 class="alert-heading">✅ Đã đăng nhập</h5>
        <hr>
        <p class="mb-1"><strong>Tên đăng nhập:</strong> @tenDangNhap</p>
        <p class="mb-1"><strong>Họ và tên:</strong> @hoVaTen</p>
        <p class="mb-1"><strong>Vai trò:</strong> <span class="badge bg-success">@vaiTro</span></p>
        <p class="mb-0"><strong>User ID:</strong> @userId</p>
        <hr>
        <a href="/Account/Logout" class="btn btn-sm btn-danger">Đăng xuất</a>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 9999; max-width: 350px;">
        <h5 class="alert-heading">⚠️ Chưa đăng nhập</h5>
        <p class="mb-0">Không tìm thấy thông tin trong Session</p>
    </div>
} *@

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Chợ Tốt X  © 2025  - Mua bán xe ô tô, xe máy, xe điện uy tín hàng đầu Việt Nam">
    <title>Chợ Tốt Xe - Mua Bán Xe Uy Tín Hàng Đầu Việt Nam</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700;900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
    <!-- Custom CSS (Minimal) -->
    <link rel="stylesheet" href="../css/style.css">
</head>

<body class="bg-light overflow-x-hidden">
    <!-- Header -->
    <!-- Header -->
    @* <header class="sticky-top bg-white shadow-sm">


        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-content">
                <button class="btn-close-menu" id="closeMobileMenu">
                    <i class="fas fa-times"></i>
                </button>

            </div>
        </div>
    </header> *@

    <!-- Hero Section -->
    <section class="hero-section position-relative overflow-hidden">
        <!-- Header Top moved here -->
        <div class="container">
            <div class="d-flex align-items-center justify-content-between py-2">
                <!-- Logo -->
                <a href="#" class="logo d-flex align-items-center gap-0 ">
                    <img src="/images/logo.png" alt="" class="logo-icon">
                    <img src="/images/logo_word.png" alt="" class="logo-text">
                </a>
                <div class="container-fluid">
                    <!-- Secondary Navigation -->
                    <div class=" d-none d-lg-block">
                        <div class="container">
                            <div class="py-2">
                                <a href="#" class="text-decoration-none text-dark">
                                    Dành cho người bán <i class="fas fa-chevron-down ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Yêu thích">
                        <i class="far fa-heart"></i>
                    </button>
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Tin nhắn">
                        <i class="far fa-comment-dots"></i>
                    </button>
                    <button class="btn-icon d-none d-md-inline-flex" aria-label="Thông báo">
                        <i class="far fa-bell"></i>
                    </button>

                    @{
                        var fullName = Context.Session.GetString("FullName");
                        var isLoggedIn = !string.IsNullOrEmpty(fullName);
                    }

                    @if (isLoggedIn)
                    {
                        <!-- Hiển thị khi đã đăng nhập -->
                        <div class="dropdown d-none d-md-inline-flex">
                            <button class="btn btn-outline-primary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i> @fullName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user me-2"></i>Tài khoản</a></li>

                                @* Hiển thị menu quản lý đơn hàng theo vai trò *@
                                @if (ViewBag.IsAdmin == true || ViewBag.IsSaler == true)
                                {
                                    <li><a class="dropdown-item" href="/Home/ManageOrders"><i class="fas fa-tasks me-2"></i>Quản lý đơn hàng</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" href="/Home/MyOrders"><i class="fas fa-shopping-bag me-2"></i>Đơn hàng của tôi</a></li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Hiển thị khi chưa đăng nhập -->
                        <a href="/Account/Login">
                            <button class="btn btn-outline-primary d-none d-md-inline-flex">
                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                            </button>
                        </a>
                    }

                    <button class="btn btn-primary">Bán xe</button>
                    <button class="btn-icon d-lg-none" id="mobileMenuToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="text-center">
                <h1 class="hero-title mb-0">&#34;Xe&#34; mới toanh. Khám phá nhanh!</h1>
            </div>
