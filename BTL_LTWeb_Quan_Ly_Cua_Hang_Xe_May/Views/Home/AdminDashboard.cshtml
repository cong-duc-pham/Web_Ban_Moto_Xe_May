@model IEnumerable<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.Vehicle>
@{
    // Trỏ đến vị trí mới trong thư mục Shared
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan";
}


<div class="page-header">
    <h1>Tổng quan hệ thống</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>

<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon blue">
                <i class="fas fa-users"></i>
            </div>
        </div>
        <div class="stat-value">1,284</div>
        <div class="stat-label">Tổng khách hàng</div>
        <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> 12.5% tăng
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon green">
                <i class="fas fa-car"></i>
            </div>
        </div>
        <div class="stat-value">456</div>
        <div class="stat-label">Xe đang bán</div>
        <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> 8.3% tăng
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon orange">
                <i class="fas fa-file-alt"></i>
            </div>
        </div>
        <div class="stat-value">89</div>
        <div class="stat-label">Bài đăng chờ duyệt</div>
        <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> 5 mới
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon red">
                <i class="fas fa-dollar-sign"></i>
            </div>
        </div>
        <div class="stat-value">128M</div>
        <div class="stat-label">Doanh thu tháng</div>
        <div class="stat-change down">
            <i class="fas fa-arrow-down"></i> 3.2% giảm
        </div>
    </div>
</div>

<!-- Recent Customers Table -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-users"></i> Khách hàng mới nhất</h3>
        <div class="btn-group">
            <button class="btn btn-outline">
                <i class="fas fa-filter"></i> Lọc
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm mới
            </button>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Ngày đăng ký</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Customers != null && ((List<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.User>)ViewBag.Customers).Any())
                {
                    foreach (var customer in (List<BTL_LTWeb_Quan_Ly_Cua_Hang_Xe_May.Models.Entities.User>)ViewBag.Customers)
                    {
                        var initials = customer.FullName?.Length >= 2 
                            ? customer.FullName.Substring(0, 2).ToUpper() 
                            : "KH";
                        var statusClass = customer.Status == "Active" ? "active" : "inactive";
                        var statusText = customer.Status == "Active" ? "Hoạt động" : "Tạm khóa";
                        
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-img">@initials</div>
                                    <div>
                                        <div style="font-weight: 600; color: var(--dark);">@customer.FullName</div>
                                        <div style="font-size: 12px;">ID: #KH@customer.UserId.ToString("D3")</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(customer.Email ?? "Chưa cập nhật")</td>
                            <td>@customer.PhoneNumber</td>
                            <td>@DateTime.Now.AddDays(-customer.UserId).ToString("dd/MM/yyyy")</td>
                            <td><span class="status-badge @statusClass">@statusText</span></td>
                            <td>
                                <button class="action-btn view" onclick="viewCustomer(@customer.UserId)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn edit" onclick="editCustomer(@customer.UserId)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-btn delete" onclick="deleteCustomer(@customer.UserId, '@customer.FullName')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--secondary);">
                            <i class="fas fa-inbox fa-3x" style="opacity: 0.3; margin-bottom: 10px;"></i>
                            <p>Chưa có khách hàng nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Vehicles List Section -->
<div class="card" style="margin-top: 30px;">
    <div class="card-header">
        <h3><i class="fas fa-motorcycle"></i> Danh sách xe</h3>
        <div class="btn-group">
            <input type="text" id="searchVehicle" class="form-control" placeholder="Tìm kiếm xe..." 
                   style="width: 300px; margin-right: 10px; border-radius: 8px; border: 1px solid #ddd; padding: 8px 15px;">
            <select id="filterStatus" class="form-select" style="width: 150px; border-radius: 8px; border: 1px solid #ddd;">
                <option value="">Tất cả</option>
                <option value="Available">Còn hàng</option>
                <option value="SoldOut">Hết hàng</option>
                <option value="Reserved">Đã đặt</option>
            </select>
        </div>
    </div>
    <div class="table-container">
        <table id="vehiclesTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Hình ảnh</th>
                    <th>Tên xe</th>
                    <th>Hãng</th>
                    <th>Loại</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Đã bán</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var vehicle in Model)
                    {
                        var mainImage = vehicle.VehicleImages?.FirstOrDefault()?.ImagePath ?? "/images/no-image.png";
                        var statusClass = vehicle.Status == "Available" ? "active" : 
                                        vehicle.Status == "SoldOut" ? "inactive" : "pending";
                        var statusText = vehicle.Status == "Available" ? "Còn hàng" :
                                       vehicle.Status == "SoldOut" ? "Hết hàng" : vehicle.Status;
                        
                        <tr data-title="@vehicle.Title" 
                            data-brand="@(vehicle.Brand?.BrandName ?? "")" 
                            data-status="@vehicle.Status">
                            <td><strong>#@vehicle.VehicleId</strong></td>
                            <td>
                                <img src="@mainImage" alt="@vehicle.Title" 
                                     style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" 
                                     onerror="this.src='/images/no-image.png'" />
                            </td>
                            <td>
                                <div>
                                    <div style="font-weight: 600; color: var(--dark);">@vehicle.Title</div>
                                    <div style="font-size: 12px; color: var(--secondary);">
                                        @vehicle.Model @if(vehicle.ManufactureYear.HasValue) { <text>- @vehicle.ManufactureYear</text> }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background-color: #3498db; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px;">
                                    @(vehicle.Brand?.BrandName ?? "N/A")
                                </span>
                            </td>
                            <td>
                                <span class="badge" style="background-color: #9b59b6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px;">
                                    @(vehicle.Category?.CategoryName ?? "N/A")
                                </span>
                            </td>
                            <td>
                                <strong style="color: #e74c3c;">@((vehicle.SalePrice ?? 0).ToString("N0")) đ</strong>
                            </td>
                            <td>
                                <span class="badge" style="background-color: @(vehicle.StockQuantity > 0 ? "#27ae60" : "#e74c3c"); color: white; padding: 4px 8px; border-radius: 4px;">
                                    @vehicle.StockQuantity
                                </span>
                            </td>
                            <td>@vehicle.SoldCount</td>
                            <td>
                                <span class="status-badge @statusClass">@statusText</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 40px; color: var(--secondary);">
                            <i class="fas fa-inbox fa-3x" style="opacity: 0.3; margin-bottom: 10px;"></i>
                            <p>Chưa có xe nào trong hệ thống</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Customer management functions
    function viewCustomer(userId) {
        alert('Xem chi tiết khách hàng ID: ' + userId + ' (Chức năng đang phát triển)');
    }

    function editCustomer(userId) {
        alert('Chỉnh sửa khách hàng ID: ' + userId + ' (Chức năng đang phát triển)');
    }

    function deleteCustomer(userId, customerName) {
        if (confirm(`Bạn có chắc chắn muốn xóa khách hàng "${customerName}"?\n\nLưu ý: Chỉ có thể xóa khách hàng chưa có đơn hàng.`)) {
            fetch('/Home/DeleteCustomer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `userId=${userId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa khách hàng!');
            });
        }
    }

    // Search and filter vehicles
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchVehicle');
        const filterStatus = document.getElementById('filterStatus');
        
        function filterVehicles() {
            const searchTerm = searchInput.value.toLowerCase();
            const statusFilter = filterStatus.value;
            
            const rows = document.querySelectorAll('#vehiclesTable tbody tr');
            
            rows.forEach(row => {
                if (row.querySelector('td[colspan]')) return; // Skip "no data" row
                
                const title = row.dataset.title?.toLowerCase() || '';
                const brand = row.dataset.brand?.toLowerCase() || '';
                const status = row.dataset.status || '';
                
                const matchSearch = title.includes(searchTerm) || brand.includes(searchTerm);
                const matchStatus = !statusFilter || status === statusFilter;
                
                if (matchSearch && matchStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        
        searchInput.addEventListener('input', filterVehicles);
        filterStatus.addEventListener('change', filterVehicles);
    });
    
    // Customer management functions
    function viewCustomer(userId) {
        alert('Xem chi tiết khách hàng ID: ' + userId + ' (Chức năng đang phát triển)');
    }

    function editCustomer(userId) {
        alert('Chỉnh sửa khách hàng ID: ' + userId + ' (Chức năng đang phát triển)');
    }

    function deleteCustomer(userId, customerName) {
        if (confirm(`Bạn có chắc chắn muốn xóa khách hàng "${customerName}"?\n\nLưu ý: Chỉ có thể xóa khách hàng chưa có đơn hàng.`)) {
            fetch('/Home/DeleteCustomer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `userId=${userId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa khách hàng!');
            });
        }
    }
</script>

<script src="/js/AdminLayout.js"> </script>