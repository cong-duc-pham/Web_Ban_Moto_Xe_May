@{
    ViewData["Title"] = "SH 150i 2015 khoá Smarkey BSTP chính chủ - Chợ Tốt Xe";
    Layout = "~/Views/Shared/_ViewStart.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-detail.css">
}

<!-- Breadcrumb -->
<section class="breadcrumb-section py-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="index.html">Chợ Tốt Xe</a></li>
                <li class="breadcrumb-item"><a href="#">Xe máy</a></li>
                <li class="breadcrumb-item"><a href="#">Xe máy Tp Hồ Chí Minh</a></li>
                <li class="breadcrumb-item"><a href="#">Xe máy Thành phố Thủ Đức</a></li>
                <li class="breadcrumb-item active" aria-current="page">SH 150i 2015 khoá Smarkey BSTP chính chủ</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Main Content -->
<section class="product-detail-section py-4">
    <div class="container">
        <div class="row g-4">
            <!-- Left Column: Gallery -->
            <div class="col-lg-7">
                <div class="product-gallery">
                    <div class="gallery-main">
                        <button class="gallery-action-btn share-btn" id="shareBtn">
                            <i class="fas fa-share-alt"></i>
                        </button>
                        <button class="gallery-action-btn more-btn" id="moreBtn">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <button class="gallery-nav gallery-nav-prev" id="galleryPrev">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <img id="mainImage"
                             src="https://images.unsplash.com/photo-1554282775-257f006125b5?crop=entropy&cs=srgb&fm=jpg&q=85&w=800"
                             alt="SH 150i 2015 - Martin Péchy on Unsplash" class="gallery-main-image">
                        <button class="gallery-nav gallery-nav-next" id="galleryNext">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        <div class="gallery-counter">
                            <span id="currentImage">1</span>/<span id="totalImages">7</span>
                        </div>
                    </div>
                    <div class="gallery-thumbnails" id="galleryThumbnails">
                        <!-- Thumbnails will be inserted by JS -->
                    </div>
                </div>

                <!-- Description Section -->
                <div class="product-description-card mt-4">
                    <h3 class="section-title-small">Mô tả chi tiết</h3>
                    <div class="description-content">
                        <p>Bán xe SH 150i đời 2015</p>
                        <p>Xe dàn ngoại đẹp keng, khoá smarkey</p>
                        <p>Máy móc nguyên zin 100% êm ru</p>
                        <p>Bs Thành Phố chính chủ công chứng</p>
                        <p>Giá 44 triệu có fix</p>
                        <p>Xem xe tại 78 Nguyễn Văn Tăng, TP Thủ Đức</p>
                        <div class="phone-reveal mt-3">
                            <span class="me-2">SĐT liên hệ:</span>
                            <span id="phoneNumber">093333****</span>
                            <button class="btn-reveal-phone" id="revealPhoneBtn">Hiện số</button>
                        </div>
                    </div>
                </div>

                <!-- Specifications -->
                <div class="product-specs-card mt-4">
                    <h3 class="section-title-small">Thông số kỹ thuật</h3>
                    <div class="specs-grid">
                        <div class="spec-item">
                            <div class="spec-label">Hãng xe:</div>
                            <div class="spec-value"><a href="#">Honda</a></div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Dòng xe:</div>
                            <div class="spec-value"><a href="#">SH</a></div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Năm sản xuất:</div>
                            <div class="spec-value">2015</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Số Km đã đi:</div>
                            <div class="spec-value">34000</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Tình trạng:</div>
                            <div class="spec-value">Đã sử dụng</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Loại xe:</div>
                            <div class="spec-value">Tay ga</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Xuất xứ:</div>
                            <div class="spec-value">Việt Nam</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Chính sách bảo hành:</div>
                            <div class="spec-value">Bảo hành hãng</div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-label">Trọng lượng:</div>
                            <div class="spec-value">> 50 kg</div>
                        </div>
                    </div>
                </div>

                <!-- Services Card -->
                <div class="services-card mt-4">
                    <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=600&h=150&fit=crop"
                         alt="Chuyển nhà nào làm xe" class="services-banner">
                    <h4 class="services-title">Các dịch vụ tiện ích</h4>
                    <ul class="services-list">
                        <li><i class="fas fa-check-circle"></i> Bán xe nhanh trong 2 tiếng</li>
                        <li><i class="fas fa-check-circle"></i> Nhận tiền ngay</li>
                        <li><i class="fas fa-check-circle"></i> Hỗ trợ sang tên dễ dàng</li>
                    </ul>
                    <button class="btn btn-primary w-100">Bán xe ngay</button>
                </div>
            </div>

            <!-- Right Column: Product Info -->
            <div class="col-lg-5">
                <div class="product-info-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h1 class="product-title">SH 150i 2015 khoá Smarkey BSTP chính chủ</h1>
                        <button class="btn-favorite" id="favoriteBtn">
                            <i class="far fa-heart"></i>
                            <span class="ms-1">Lưu</span>
                        </button>
                    </div>

                    <div class="product-meta mb-3">
                        2015 • 34000 km • Việt Nam
                    </div>

                    <div class="product-price mb-3">44.000.000 đ</div>

                    <!-- Price Comparison -->
                    <div class="price-comparison mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="comparison-label">Khoảng giá thị trường</span>
                            <i class="fas fa-info-circle text-secondary" data-bs-toggle="tooltip"
                               title="So sánh với giá thị trường"></i>
                        </div>
                        <div class="price-slider-container">
                            <div class="price-range-labels">
                                <span>36.27 tr</span>
                                <span>42.57 tr</span>
                            </div>
                            <div class="price-slider">
                                <div class="price-slider-track"></div>
                                <div class="price-slider-fill" style="left: 0%; width: 75%;"></div>
                                <div class="price-slider-thumb" style="left: 75%;">
                                    <div class="price-tooltip">44 triệu</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons mb-4">
                        <button class="btn btn-outline-secondary flex-grow-1">
                            <i class="far fa-comment-dots me-2"></i>Chat
                        </button>
                        <button class="btn btn-primary flex-grow-1" id="callBtn">
                            <i class="fas fa-phone me-2"></i>Hiện số 093333****
                        </button>
                    </div>

                    <!-- Location & Time -->
                    <div class="product-location mb-2">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Phường Long Thạnh Mỹ (Quận 9 cũ), Thành phố Thủ Đức, Tp Hồ Chí Minh
                    </div>
                    <div class="product-time text-secondary">
                        <i class="far fa-clock me-2"></i>Đăng 2 tháng trước
                    </div>
                </div>

                <!-- Seller Info -->
                <div class="seller-card mt-4">
                    <div class="seller-header">
                        <img src="https://i.pravatar.cc/80?img=12" alt="Cửa Hàng Xe NGUYÊN" class="seller-avatar">
                        <div class="seller-info">
                            <h4 class="seller-name">Cửa Hàng Xe NGUYÊN</h4>
                            <div class="seller-rating">
                                <span class="rating-stars">★★★★☆</span>
                                <span class="rating-text">4.1</span>
                                <span class="text-secondary">(13 Đánh giá)</span>
                            </div>
                            <div class="seller-stats">
                                <span>8 đã bán</span> • <span>25 đang bán</span>
                            </div>
                        </div>
                    </div>
                    <div class="seller-activity">
                        <span class="activity-dot"></span>
                        Hoạt động 6 phút trước
                        <span class="ms-3">Phản hồi: 81%</span>
                    </div>
                    <div class="seller-questions">
                        <p class="mb-2 fw-semibold">Chat nhanh:</p>
                        <div class="question-chips">
                            <button class="question-chip">Xe còn hay đã bán rồi?</button>
                            <button class="question-chip">Xe chính chủ hay</button>
                        </div>
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="comments-card mt-4">
                    <h4 class="section-title-small">Bình luận</h4>
                    <div class="comments-empty">
                        <i class="far fa-comment-dots empty-icon"></i>
                        <p class="text-secondary mb-2">Chưa có bình luận nào.</p>
                        <p class="text-secondary small">Hãy để lại bình luận cho người bán.</p>
                    </div>
                    <div class="comment-input">
                        <img src="https://i.pravatar.cc/40?img=5" alt="User" class="comment-avatar">
                        <input type="text" class="form-control" placeholder="Bình luận...">
                        <button class="btn-send-comment">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seller Other Listings -->
        <section class="related-listings mt-5">
            <h2 class="section-title">Tin rao khác của Vận</h2>
            <div class="position-relative">
                <button class="carousel-nav carousel-nav-prev d-none d-lg-flex" data-carousel="sellerListings">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="carousel-wrapper" id="sellerListingsCarousel">
                    <!-- Cards will be inserted by JS -->
                </div>
                <button class="carousel-nav carousel-nav-next d-none d-lg-flex" data-carousel="sellerListings">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            <div class="text-center mt-4">
                <button class="btn btn-outline-secondary">Xem tin từ người bán</button>
            </div>
        </section>

        <!-- Similar Listings -->
        <section class="similar-listings mt-5">
            <h2 class="section-title">Tin đăng tương tự</h2>
            <div class="row g-3" id="similarListingsGrid">
                <!-- Cards will be inserted by JS -->

            </div>
            <div class="text-center mt-4">
                <button class="btn btn-outline-secondary">Xem thêm tin đăng</button>
            </div>
        </section>
    </div>
</section>

<!-- More Options Menu -->
<div class="dropdown-menu-custom" id="moreMenu">
    <button class="dropdown-item-custom"><i class="fas fa-flag me-2"></i>Báo cáo tin đăng</button>
    <button class="dropdown-item-custom"><i class="fas fa-link me-2"></i>Sao chép liên kết</button>
    <button class="dropdown-item-custom"><i class="fas fa-print me-2"></i>In tin đăng</button>
</div>

@section Scripts {
    <script src="~/js/product-detail.js"></script>
}