@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Quản lý Xe</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/AdminLayout.css">
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="logo">
            <i class="fas fa-car"></i>
            <span class="logo-text">Wings Motorbike</span>
        </div>
        <div class="menu">
            <a asp-controller="Home" asp-action="AdminDashboard"
               class="menu-item @(currentAction == "AdminDashboard" ? "active" : "")">
                <i class="fas fa-chart-line"></i>
                <span class="menu-text">Tổng quan</span>
            </a>

            <a asp-controller="Home" asp-action="ManageEmployee"
               class="menu-item @(currentAction == "ManageEmployee" ? "active" : "")">
                <i class="fas fa-clipboard-user"></i>
                <span class="menu-text">Quản lý nhân viên</span>
            </a>


            <a asp-controller="Home" asp-action="ManageCustomers"
               class="menu-item @(currentAction == "ManageCustomers" ? "active" : "")">
                <i class="fas fa-users"></i>
                <span class="menu-text">Quản lý khách hàng</span>
                <span class="badge-notify">12</span>
            </a>

            <a asp-controller="Home" asp-action="ManageVehicles"
               class="menu-item @(currentAction == "ManageVehicles" ? "active" : "")">
                <i class="fas fa-car-side"></i>
                <span class="menu-text">Quản lý xe</span>
            </a>

            <a asp-controller="Home" asp-action="ManagePosts"
               class="menu-item @(currentAction == "ManagePosts" ? "active" : "")">
                <i class="fas fa-file-alt"></i>
                <span class="menu-text">Quản lý bài đăng</span>
                <span class="badge-notify">5</span>
            </a>

            @* <a asp-controller="Home" asp-action="ManageNews"
               class="menu-item @(currentAction == "ManageNews" ? "active" : "")">
                <i class="fas fa-newspaper"></i>
                <span class="menu-text">Tin tức</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="ManageStores"
               class="menu-item @(currentAction == "ManageStores" ? "active" : "")">
                <i class="fas fa-store"></i>
                <span class="menu-text">Cửa hàng</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="ManageComments"
               class="menu-item @(currentAction == "ManageComments" ? "active" : "")">
                <i class="fas fa-comments"></i>
                <span class="menu-text">Bình luận</span>
                <span class="badge-notify">24</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="Statistics"
               class="menu-item @(currentAction == "Statistics" ? "active" : "")">
                <i class="fas fa-chart-bar"></i>
                <span class="menu-text">Thống kê</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="Settings"
               class="menu-item @(currentAction == "Settings" ? "active" : "")">
                <i class="fas fa-cog"></i>
                <span class="menu-text">Cài đặt</span>
            </a> *@
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Navbar -->
        <div class="navbar">
            <div class="navbar-left">
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="search-box">
                    <input type="text" placeholder="Tìm kiếm khách hàng, xe, bài đăng...">
                    <i class="fas fa-search"></i>
                </div>
            </div>
            <div class="navbar-right">
                @* <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge"></span>
                </button>
                <button class="icon-btn">
                    <i class="fas fa-envelope"></i>
                    <span class="badge"></span>
                </button> *@
                <div class="user-profile">
                    <div class="user-avatar">AD</div>
                    <div>
                        <div style="font-weight: 600; font-size: 14px;">Admin</div>
                        <div style="font-size: 12px; color: var(--secondary);">Quản trị viên</div>
                    </div>
                    <i class="fas fa-chevron-down" style="color: var(--secondary); font-size: 12px;"></i>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            @RenderBody();
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="/js/AdminLayout.js"> </script>
</body>
</html>