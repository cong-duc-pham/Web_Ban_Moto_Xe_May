@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    
    // Lấy thông tin người dùng từ Session
    var fullName = Context.Session.GetString("FullName") ?? "Admin";
    var roleName = Context.Session.GetString("RoleName") ?? "Quản trị viên";
    
    // Lấy 2 chữ cái đầu của tên để làm avatar
    var initials = "AD";
    if (!string.IsNullOrEmpty(fullName))
    {
        var nameParts = fullName.Split(' ');
        if (nameParts.Length >= 2)
        {
            initials = nameParts[^2].Substring(0, 1).ToUpper() + nameParts[^1].Substring(0, 1).ToUpper();
        }
        else if (nameParts.Length == 1 && nameParts[0].Length >= 2)
        {
            initials = nameParts[0].Substring(0, 2).ToUpper();
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Quản lý Xe</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/AdminLayout.css">
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="logo">
            <i class="fas fa-car"></i>
            <span class="logo-text">Wings Motorbike</span>
        </div>
        <div class="menu">
            <a asp-controller="Home" asp-action="AdminDashboard"
               class="menu-item @(currentAction == "AdminDashboard" ? "active" : "")">
                <i class="fas fa-chart-line"></i>
                <span class="menu-text">Tổng quan</span>
            </a>

            <a asp-controller="Home" asp-action="ManageEmployee"
               class="menu-item @(currentAction == "ManageEmployee" ? "active" : "")">
                <i class="fas fa-clipboard-user"></i>
                <span class="menu-text">Quản lý nhân viên</span>
            </a>


            <a asp-controller="Home" asp-action="ManageCustomers"
               class="menu-item @(currentAction == "ManageCustomers" ? "active" : "")">
                <i class="fas fa-users"></i>
                <span class="menu-text">Quản lý khách hàng</span>
                <span class="badge-notify">12</span>
            </a>

            <a asp-controller="Home" asp-action="ManageVehicles"
               class="menu-item @(currentAction == "ManageVehicles" ? "active" : "")">
                <i class="fas fa-car-side"></i>
                <span class="menu-text">Quản lý xe</span>
            </a>

            <a asp-controller="Home" asp-action="ManagePosts"
               class="menu-item @(currentAction == "ManagePosts" ? "active" : "")">
                <i class="fas fa-file-alt"></i>
                <span class="menu-text">Quản lý bài đăng</span>
                <span class="badge-notify">5</span>
            </a>

            @* <a asp-controller="Home" asp-action="ManageNews"
               class="menu-item @(currentAction == "ManageNews" ? "active" : "")">
                <i class="fas fa-newspaper"></i>
                <span class="menu-text">Tin tức</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="ManageStores"
               class="menu-item @(currentAction == "ManageStores" ? "active" : "")">
                <i class="fas fa-store"></i>
                <span class="menu-text">Cửa hàng</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="ManageComments"
               class="menu-item @(currentAction == "ManageComments" ? "active" : "")">
                <i class="fas fa-comments"></i>
                <span class="menu-text">Bình luận</span>
                <span class="badge-notify">24</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="Statistics"
               class="menu-item @(currentAction == "Statistics" ? "active" : "")">
                <i class="fas fa-chart-bar"></i>
                <span class="menu-text">Thống kê</span>
            </a> *@

            @* <a asp-controller="Home" asp-action="Settings"
               class="menu-item @(currentAction == "Settings" ? "active" : "")">
                <i class="fas fa-cog"></i>
                <span class="menu-text">Cài đặt</span>
            </a> *@
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Navbar -->
        <div class="navbar">
            <div class="navbar-left">
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="search-box">
                    <input type="text" placeholder="Tìm kiếm khách hàng, xe, bài đăng...">
                    <i class="fas fa-search"></i>
                </div>
            </div>
            <div class="navbar-right">
                @* <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge"></span>
                </button>
                <button class="icon-btn">
                    <i class="fas fa-envelope"></i>
                    <span class="badge"></span>
                </button> *@
                <div class="user-profile-wrapper">
                    <div class="user-profile" onclick="toggleUserMenu()">
                        <div class="user-avatar">@initials</div>
                        <div>
                            <div style="font-weight: 600; font-size: 14px;">@fullName</div>
                            <div style="font-size: 12px; color: var(--secondary);">@roleName</div>
                        </div>
                        <i class="fas fa-chevron-down" style="color: var(--secondary); font-size: 12px;"></i>
                    </div>
                    
                    <!-- Dropdown Menu -->
                    <div class="user-dropdown-menu" id="userDropdownMenu">
                        <a href="/QA/Index" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Trang hỏi đáp</span>
                        </a>
                        <a href="/Account/AccountProfile" class="dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Thông tin cá nhân</span>
                        </a>
                        <a href="/Home/ManageOrders" class="dropdown-item">
                            <i class="fas fa-tasks"></i>
                            <span>Quản lý đơn hàng</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="/Account/Logout" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            @RenderBody();
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Toggle user dropdown menu
        function toggleUserMenu() {
            const menu = document.getElementById('userDropdownMenu');
            menu.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            const userProfile = document.querySelector('.user-profile-wrapper');
            const menu = document.getElementById('userDropdownMenu');
            
            if (!userProfile.contains(event.target)) {
                menu.classList.remove('show');
            }
        });
    </script>
    
    <script src="/js/AdminLayout.js"> </script>
</body>
</html>