<header class="sticky-header" data-header>
    <div class="header-container">
        <div class="header-left">
            <a href="/" class="header-logo">
                Wings<span class="logo-xe">Motorbike</span>
            </a>
        </div>

        <div class="header-center">
            <form class="search-form" id="headerSearchForm">
                <div class="search-bar">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" 
                           placeholder="Tìm xe cộ..." 
                           name="q" 
                           id="headerSearchInput"
                           class="search-input" />
                </div>
                <button type="submit" class="search-submit-btn" aria-label="Tìm kiếm">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>

        <div class="header-right">
            <button class="header-icon-btn" aria-label="Tin đã lưu">
                <i class="far fa-heart"></i>
            </button>
            @* <button class="header-icon-btn" aria-label="Thông báo">
                <i class="far fa-bell"></i>
            </button>    *@
            @* <a href="#" class="manage-link">Quản lý tin</a> *@
            @* <a href="#" class="post-ad-btn">Đăng xe</a> *@
            
            @{
                var fullName = Context.Session.GetString("FullName") ?? "Khách";
                var roleName = Context.Session.GetString("RoleName") ?? "";
                var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("UserId"));
                var avatarInitial = fullName.Substring(0, 1).ToUpper();
                var isAdminOrSaler = roleName == "Admin" || roleName == "Saler";
            }
            
            @if (isLoggedIn)
            {
                <div class="user-profile-wrapper">
                    <button class="user-profile-btn" onclick="toggleUserMenu()" aria-label="Tài khoản">
                        <span class="avatar-initial">@avatarInitial</span>
                        <span class="user-name">@fullName</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    
                    <!-- Dropdown Menu -->
                    <div class="user-dropdown-menu" id="userDropdownMenu">
                        <a href="/QA/Index" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Trang hỏi đáp</span>
                        </a>
                        <a href="/Account/AccountProfile" class="dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Thông tin cá nhân</span>
                        </a>
                        
                        @if (isAdminOrSaler)
                        {
                            <a href="/Home/ManageOrders" class="dropdown-item">
                                <i class="fas fa-tasks"></i>
                                <span>Quản lý đơn hàng</span>
                            </a>
                        }
                        else
                        {
                            <a href="/Home/MyOrders" class="dropdown-item">
                                <i class="fas fa-shopping-bag"></i>
                                <span>Đơn hàng của tôi</span>
                            </a>
                        }
                        
                        <div class="dropdown-divider"></div>
                        <a href="/Account/Logout" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <a href="/Account/Login" class="post-ad-btn">Đăng nhập</a>
            }

        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle User Menu
    window.toggleUserMenu = function() {
        const menu = document.getElementById('userDropdownMenu');
        if (menu) {
            menu.classList.toggle('show');
        }
    };

    // Đóng menu khi click bên ngoài
    document.addEventListener('click', function(event) {
        const wrapper = document.querySelector('.user-profile-wrapper');
        const menu = document.getElementById('userDropdownMenu');
        if (wrapper && menu && !wrapper.contains(event.target)) {
            menu.classList.remove('show');
        }
    });
});
</script>

