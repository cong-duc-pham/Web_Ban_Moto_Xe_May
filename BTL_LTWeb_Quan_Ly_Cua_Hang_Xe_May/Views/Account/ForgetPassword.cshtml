@model dynamic
@{
    Layout = null;
}
<head>
    <link rel="stylesheet" href="~/css/ForgetPassword.css" />
</head>
<body class="background-yellow">
    <div class="fp-container">
        <div class="fp-box">
            <div class="fp-title">QUÊN MẬT KHẨU</div>
            @* Day la phan quen MK *@
            @if (ViewBag.Step == null || ViewBag.Step == "Email")
            {
                <form asp-action="SendOtp" method="post" autocomplete="off">
                    <label for="email" class="fp-label">Nhập email đã đăng ký</label>
                    <input type="email" name="Email" required class="fp-input" placeholder="Nhập email..." />
                    <button type="submit" class="fp-btn">Gửi mã OTP</button>
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="fp-error">@ViewBag.ErrorMessage</div>
                    }
                    @if (ViewBag.Message != null)
                    {
                        <div class="fp-success">@ViewBag.Message</div>
                    }
                </form>
            }

            @if (ViewBag.Step == "OTP")
            {
                <form asp-action="VerifyOtp" method="post" autocomplete="off">
                    <input type="hidden" name="Email" value="@ViewBag.Email" />
                    <label class="fp-label">Nhập mã OTP đã gửi tới email</label>
                    <input type="text" name="Otp" maxlength="6" required class="fp-input" placeholder="Nhập OTP 6 số" />
                    <button type="submit" class="fp-btn">Xác thực OTP</button>
                    @if (ViewBag.OtpError != null)
                    {
                        <div class="fp-error">@ViewBag.OtpError</div>
                    }
                </form>
            }

            @if (ViewBag.Step == "NewPassword")
            {
                <form asp-action="ResetPassword" method="post" autocomplete="off">
                    <input type="hidden" name="Email" value="@ViewBag.Email" />
                    <label class="fp-label">Nhập mật khẩu mới</label>
                    <input type="password" name="NewPassword" required class="fp-input" placeholder="Nhập mật khẩu mới..." />
                    <button type="submit" class="fp-btn">Đặt lại mật khẩu</button>
                    @if (ViewBag.PassChanged != null)
                    {
                        <div class="fp-success">@ViewBag.PassChanged</div>
                    }
                    @if (ViewBag.PassError != null)
                    {
                        <div class="fp-error">@ViewBag.PassError</div>
                    }
                </form>
            }
            <div class="fp-popup-overlay" id="successPopup">
                <div class="fp-popup">
                    <div class="fp-popup-icon">
                        <svg viewBox="0 0 52 52">
                            <polyline points="14 27 22 35 38 19" />
                        </svg>
                    </div>
                    <h2 class="fp-popup-title">Thành công!</h2>
                    <p class="fp-popup-message">Mật khẩu của bạn đã được đặt lại thành công. Bạn có thể đăng nhập bằng mật khẩu mới.</p>
                    <button class="fp-popup-btn" onclick="redirectToLogin()">Đăng nhập ngay</button>
                    <div class="fp-countdown">Tự động chuyển sau <span id="countdown">5</span> giây...</div>
                </div>
            </div>
            <div class="fp-under">
                <a href="/Account/Login" class="fp-link">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>

    <script>
        // Kiểm tra nếu đổi mật khẩu thành công
        @if (ViewBag.PassChanged != null)
        {
                    <text>
                    window.addEventListener('DOMContentLoaded', function() {
                        showSuccessPopup();
                    });
                    </text>
        }

        function showSuccessPopup() {
            const popup = document.getElementById('successPopup');
            popup.classList.add('show');

            // Đếm ngược và tự động chuyển hướng
            let seconds = 5;
            const countdownElement = document.getElementById('countdown');

            const countdown = setInterval(function() {
                seconds--;
                countdownElement.textContent = seconds;

                if (seconds <= 0) {
                    clearInterval(countdown);
                    redirectToLogin();
                }
            }, 1000);
        }

        function redirectToLogin() {
            window.location.href = '/Account/Login';
        }

        // Đóng popup khi click vào overlay
        document.getElementById('successPopup')?.addEventListener('click', function(e) {
            if (e.target === this) {
                redirectToLogin();
            }
        });
    </script>
</body>
