@{
    ViewData["Title"] = "Bài đăng yêu thích";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/favorite-posts.css" asp-append-version="true">

<div class="favorite-container">
    <!-- Header -->
    <div class="favorite-header">
        <h1>
            <i class="fas fa-heart"></i>
            Bài đăng yêu thích
        </h1>
        <p>Quản lý các bài đăng xe máy mà bạn đã lưu lại</p>
        <span class="favorite-count">
            <i class="fas fa-list"></i>
            Tổng: <strong id="favoriteCount">0</strong> bài đăng
        </span>
    </div>

    <!-- Controls -->
    <div class="favorite-controls">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Tìm kiếm bài đăng...">
        </div>
        <select id="sortSelect" class="sort-select">
            <option value="newest">Mới nhất</option>
            <option value="oldest">Cũ nhất</option>
            <option value="price-low">Giá: Thấp đến Cao</option>
            <option value="price-high">Giá: Cao đến Thấp</option>
        </select>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="loading-spinner" style="display: none;">
        <div class="spinner"></div>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="empty-state" style="display: none;">
        <div class="empty-icon">
            <i class="fas fa-heart"></i>
        </div>
        <h3>Chưa có bài đăng yêu thích</h3>
        <p>Bạn chưa thêm bài đăng nào vào yêu thích. Hãy duyệt qua các bài đăng và thêm chúng vào danh sách yêu thích của bạn.</p>
        <a href="/Home/MotorbikeOnline" class="btn btn-primary">
            <i class="fas fa-search"></i> Khám phá bài đăng
        </a>
    </div>

    <!-- Favorite Posts Grid -->
    <div id="favoritesGrid" class="favorite-posts-grid">
        <!-- Cards will be inserted here by JavaScript -->
    </div>
</div>

<script src="~/js/favorite-posts.js" asp-append-version="true"></script>